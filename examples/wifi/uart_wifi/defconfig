# Components
CONFIG_QCC74xLOG =n
CONFIG_FREERTOS =y
CONFIG_POSIX =y
CONFIG_TLSF =y
CONFIG_SHELL =y
CONFIG_LWIP =y
CONFIG_WIFI6 =y
CONFIG_RF =y
CONFIG_MBEDTLS =y
CONFIG_MBEDTLS_V3 =y
#CONFIG_PSRAM_COPY_CODE =y
CONFIG_DHCPD =y
CONFIG_PING =y
#CONFIG_MQTT =y
CONFIG_NETBUS =y
CONFIG_ATMODULE_UART =y
CONFIG_LWIP_ALTCP =y
CONFIG_ATMOUDLE =y
CONFIG_POST_BUILDS_GENERATE_LITTLEFS =y

# easyflash
CONFIG_LITTLEFS =y
CONFIG_LITTLEFS_KV_EASYFLASH =y
CONFIG_QCC74x_MTD =y
CONFIG_PARTITION =y

CONFIG_MQTT =y

CONFIG_VSNPRINTF_FLOAT =y
CONFIG_VSNPRINTF_FLOAT_EX =y
CONFIG_VSNPRINTF_LONG_LONG =y

# mbedtls
CONFIG_MBEDTLS_AES_USE_HW =n
CONFIG_MBEDTLS_BIGNUM_USE_HW =n
CONFIG_MBEDTLS_ECC_USE_HW =n
CONFIG_MBEDTLS_SHA1_USE_HW =n
CONFIG_MBEDTLS_SHA256_USE_HW =n
CONFIG_MBEDTLS_SHA512_USE_HW =n

CONFIG_PS_EXTEND =y
# wifi
CONFIG_VIF_MAX =2
CONFIG_STA_MAX =4

#CONFIG_USE_LPAPP =y
CONFIG_ANTENNA_CONTROL =y

ifeq ($(CONFIG_USE_LPAPP),y)
    CONFIG_LPAPP =y
    CONFIG_PM =y
    CONFIG_LWIP_LP =y
    CONFIG_MAC_TXQ_DEPTH =8
    CONFIG_MAC_RXQ_DEPTH =12
    CONFIG_DCDC_ENABLE =n
    CONFIG_TICKLESS_WIFI_BLE =y
    CONFIG_POST_BUILDS_CONCAT_WITH_LP_FW =y
else
    CONFIG_MAC_TXQ_DEPTH =16
    CONFIG_MAC_RXQ_DEPTH =12
endif

CONFIG_BLUETOOTH_APP =y
ifeq ($(CONFIG_BLUETOOTH_APP),y)
    CONFIG_BLUETOOTH =y
    CONFIG_BTBLECONTROLLER_LIB =ble1m2s1bredr0
    CONFIG_DISABLE_BT_HOST_PRIVACY =y
    CONFIG_DYNAMIC_GATTS =y
    CONFIG_BT_SMP =y
    CONFIG_BT_SETTINGS =y
    CONFIG_BLE_USE_MAC2 =n
    CONFIG_BT_STACK_CLI =n

    # BLE profile
    CONFIG_BT_BAS_SERVER =y
    CONFIG_BT_IAS_SERVER =y
    CONFIG_BT_DIS_SERVER =y
endif

#set local 4M.toml
CONFIG_OVERRIDE_PTFILE =4M.toml