# Components
CONFIG_QCC74xLOG =n
CONFIG_FREERTOS =y
CONFIG_POSIX =y
CONFIG_TLSF =y
CONFIG_SHELL =n
CONFIG_LWIP =y
CONFIG_WIFI6 =y
CONFIG_MBEDTLS =y
CONFIG_MBEDTLS_V3 =y
CONFIG_RF =y
#setCONFIG_PSRAM_COPY_CODE =y
CONFIG_DHCPD =y
CONFIG_PING =y
CONFIG_LWIP_ALTCP =y
CONFIG_NETBUS =y
CONFIG_ATMODULE_NXSPI =y
CONFIG_ATMOUDLE =y
CONFIG_POST_BUILDS_GENERATE_LITTLEFS =y

# easyflash
CONFIG_LITTLEFS =y
CONFIG_LITTLEFS_KV_EASYFLASH =y
CONFIG_QCC74x_MTD =y
CONFIG_PARTITION =y

CONFIG_VSNPRINTF_FLOAT      =y
CONFIG_VSNPRINTF_FLOAT_EX   =y
CONFIG_VSNPRINTF_LONG_LONG  =y

# mbedtls
CONFIG_MBEDTLS_AES_USE_HW =y
CONFIG_MBEDTLS_BIGNUM_USE_HW =n
CONFIG_MBEDTLS_ECC_USE_HW =y
CONFIG_MBEDTLS_SHA1_USE_HW =y
CONFIG_MBEDTLS_SHA256_USE_HW =y
CONFIG_MBEDTLS_SHA512_USE_HW =y

ifeq ($(CONFIG_SHELL),y)
CONFIG_PS_EXTEND =y
else
CONFIG_PS_EXTEND =n
endif
CONFIG_TLSF_DEBUG =y
# wifi
CONFIG_VIF_MAX =2
CONFIG_STA_MAX =4

ifeq ($(CONFIG_LWIP_ONHOST_ENABLE),y)
CONFIG_NXSPI_NET =y
ifeq ($(CONFIG_HCI_SPI_ENABLE),y)
CONFIG_NXSPI_HCI =y
else ifeq ($(CONFIG_HCI_UART_ENABLE),y)
CONFIG_NXUART_HCI =y
endif
endif

CONFIG_MAC_TXQ_DEPTH =12
CONFIG_MAC_RXQ_DEPTH =12

ifeq ($(CONFIG_USE_LPAPP),y)
    CONFIG_LPAPP =y
    CONFIG_PM =y
    CONFIG_LWIP_LP =y
    CONFIG_DCDC_ENABLE =n
    CONFIG_TICKLESS_WIFI_BLE =y
    CONFIG_POST_BUILDS_CONCAT_WITH_LP_FW =y
endif

CONFIG_SPI_3PIN_MODE_ENABLE =y
#CONFIG_AT_DEBUG_ENABLE =y

ifeq ($(CONFIG_BLUETOOTH_APP),y)
    CONFIG_BLUETOOTH =y
    CONFIG_BTBLECONTROLLER_LIB =ble1m10s1bredr0
    CONFIG_DISABLE_BT_HOST_PRIVACY =y
    CONFIG_DYNAMIC_GATTS =y
    CONFIG_BT_SMP =y
    CONFIG_BT_SETTINGS =y
    CONFIG_BLE_USE_MAC2 =n
    CONFIG_BT_STACK_CLI =n
    # ATT MTU 512; RX buffer includes 8 bytes of HCI ACL and L2CAP headers.
    CONFIG_BT_L2CAP_TX_MTU =512
    CONFIG_BT_RX_BUF_LEN =520

    # BLE profile
    CONFIG_BT_BAS_SERVER =y
    CONFIG_BT_IAS_SERVER =y
    CONFIG_BT_DIS_SERVER =y
else
    ifeq ($(CONFIG_HCI_SPI_ENABLE),y)
        CONFIG_BLUETOOTH =y
        CONFIG_BTBLECONTROLLER_LIB =blespihci
        CONFIG_BLE_USE_MAC2 =n
    else ifeq ($(CONFIG_HCI_UART_ENABLE),y)
        CONFIG_BLUETOOTH =y
        CONFIG_BTBLECONTROLLER_LIB =bleuarthci
        CONFIG_BLE_USE_MAC2 =n
    endif
endif

ifeq ($(or $(CONFIG_OT_RCP),$(CONFIG_OT_NCP)),y)
    CONFIG_LMAC154                     =y
    CONFIG_THREAD                      =y
    CONFIG_NXSPI_OPENTHREAD_RADIO      =y
    CONFIG_OT_MTD                      =n
    ifeq ($(CONFIG_OT_NCP),y)
        CONFIG_OT_FTD = y
    else()
        CONFIG_OT_FTD = n
    endif
endif

#set local 4M.toml 
CONFIG_OVERRIDE_PTFILE =4M.toml

#CONFIG_OVERRIDE_PTFILE =partition_cfg_8M.toml
