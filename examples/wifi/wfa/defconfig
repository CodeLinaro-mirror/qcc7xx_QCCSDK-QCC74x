# Components
CONFIG_QCC74xLOG =n
CONFIG_FREERTOS =y
CONFIG_TLSF =y
CONFIG_SHELL =y
CONFIG_LWIP =y
CONFIG_WIFI6 =y
CONFIG_RF =y
CONFIG_MBEDTLS =y
CONFIG_MBEDTLS_V3 =y
CONFIG_DHCPD =y
CONFIG_PING =y
#CONFIG_MQTT =y

CONFIG_VSNPRINTF_FLOAT =y
CONFIG_VSNPRINTF_FLOAT_EX =y
CONFIG_VSNPRINTF_LONG_LONG =y

# mbedtls
CONFIG_MBEDTLS_AES_USE_HW =n
CONFIG_MBEDTLS_BIGNUM_USE_HW =n
CONFIG_MBEDTLS_ECC_USE_HW =n
CONFIG_MBEDTLS_SHA1_USE_HW =n
CONFIG_MBEDTLS_SHA256_USE_HW =n
CONFIG_MBEDTLS_SHA512_USE_HW =n

# wifi
CONFIG_VIF_MAX =2
CONFIG_STA_MAX =4
CONFIG_MAC_TXQ_DEPTH =32
CONFIG_MAC_RXQ_DEPTH =12
CONFIG_WIFI_IPERF =y
CONFIG_WIFI_TG =y

CONFIG_WFA =y

ifeq ($(CONFIG_PSRAM),y)
    CONFIG_PSRAM_COPY_CODE =y
else
    CONFIG_HIGH_ISR_STACK =y
    CONFIG_MM_SUSPEND_ALL_LOCKER =y
endif

CONFIG_OVERRIDE_BOOT2FILE =wfa_boot2.bin
