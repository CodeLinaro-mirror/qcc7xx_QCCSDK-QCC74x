diff --git a/third_party/qualcomm/qcc74x/gen_linker_script.py b/third_party/qualcomm/qcc74x/gen_linker_script.py
new file mode 100644
index 0000000000..fadff5d9f3
--- /dev/null
+++ b/third_party/qualcomm/qcc74x/gen_linker_script.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+#
+# Copyright (c) 2026 Project CHIP Authors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+# http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import argparse
+import os
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--cc", required=True)
+    parser.add_argument("--input", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--define", action="append", default=[])
+    args = parser.parse_args()
+
+    with tempfile.NamedTemporaryFile("w", delete=False) as config:
+        config_path = config.name
+        for define in args.define:
+            if "=" in define:
+                name, value = define.split("=", 1)
+            else:
+                name, value = define, "1"
+            config.write(f"#define {name} {value}\n")
+
+    os.makedirs(os.path.dirname(args.output), exist_ok=True)
+    try:
+        subprocess.check_call([
+            args.cc,
+            "-E",
+            "-P",
+            "-include",
+            config_path,
+            "-x",
+            "assembler-with-cpp",
+            args.input,
+            "-o",
+            args.output,
+        ])
+    finally:
+        os.unlink(config_path)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/third_party/qualcomm/qcc74x/qcc74x_executable.gni b/third_party/qualcomm/qcc74x/qcc74x_executable.gni
index bddc979dc1..00758c8123 100644
--- a/third_party/qualcomm/qcc74x/qcc74x_executable.gni
+++ b/third_party/qualcomm/qcc74x/qcc74x_executable.gni
@@ -66,8 +66,56 @@ template("qcc74x_executable") {
   flashing_options += [ "--baudrate" ]
   flashing_options += [ "2000000" ]
 
+  if (defined(invoker.ldscript_in)) {
+    generated_linker_script = "${target_gen_dir}/${target_name}.ld"
+    linker_script_target = "${target_name}.linker_script"
+
+    action(linker_script_target) {
+      script = "${qcc74x_build_root}/qcc74x/gen_linker_script.py"
+
+      inputs = [ invoker.ldscript_in ]
+      outputs = [ generated_linker_script ]
+
+      args = [
+        "--cc",
+        "${invoker.qcc74x_sdk_toolchain}/riscv64-unknown-elf-gcc",
+        "--input",
+        rebase_path(invoker.ldscript_in, root_build_dir),
+        "--output",
+        rebase_path(generated_linker_script, root_build_dir),
+      ]
+
+      if (defined(invoker.ldscript_defines)) {
+        foreach(define, invoker.ldscript_defines) {
+          args += [
+            "--define",
+            define,
+          ]
+        }
+      }
+    }
+  }
+
   flashable_executable(target_name) {
     forward_variables_from(invoker, "*")
+
+    if (defined(generated_linker_script)) {
+      if (!defined(ldflags)) {
+        ldflags = []
+      }
+      ldflags += [ "-T" + rebase_path(generated_linker_script, root_build_dir) ]
+
+      if (!defined(inputs)) {
+        inputs = []
+      }
+      inputs += [ generated_linker_script ]
+
+      if (!defined(deps)) {
+        deps = []
+      }
+      deps += [ ":${linker_script_target}" ]
+    }
+
     data_deps = [
       ":${flashing_config_target}",
       ":${flashing_runtime_target}",
