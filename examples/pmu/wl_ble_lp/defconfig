CONFIG_NEWLIB =n
CONFIG_NEWLIB_STANDARD =n
CONFIG_TLSF =y
CONFIG_SHELL =y
CONFIG_LWIP =y
CONFIG_WIFI6 =y
CONFIG_RF =y
CONFIG_MBEDTLS =y
CONFIG_DHCPD =y
CONFIG_PING =y

CONFIG_VSNPRINTF_NANO =n
CONFIG_VSNPRINTF_FLOAT =y
CONFIG_VSNPRINTF_FLOAT_EX =y
CONFIG_VSNPRINTF_LONG_LONG =y

# Config
## mbedtls

CONFIG_MBEDTLS_AES_USE_HW =n
CONFIG_MBEDTLS_BIGNUM_USE_HW =n
CONFIG_MBEDTLS_ECC_USE_HW =n
CONFIG_MBEDTLS_SHA1_USE_HW =n
CONFIG_MBEDTLS_SHA256_USE_HW =n
CONFIG_MBEDTLS_SHA512_USE_HW =n

#wifi
CONFIG_VIF_MAX =2
CONFIG_STA_MAX =4
CONFIG_MAC_TXQ_DEPTH =8
CONFIG_MAC_RXQ_DEPTH =12

#lpfw
CONFIG_LPAPP =y
CONFIG_POST_BUILDS_CONCAT_WITH_LP_FW =y
CONFIG_PM =y
CONFIG_LWIP_LP =y


# DCDC ENABLE
CONFIG_DCDC_ENABLE =n

CONFIG_QCC74xLOG =n
CONFIG_FREERTOS =y
ifeq ($(CONFIG_BLE_ENABLE),y)
    CONFIG_BLUETOOTH =y
    CONFIG_BTBLECONTROLLER_LIB =ble1m2s1bredr0
    CONFIG_BLE_USE_MAC2 =n
    CONFIG_BT_STACK_CLI =y
    CONFIG_TICKLESS_WIFI_BLE =y
else
    CONFIG_TICKLESS_WIFI_BLE =y
endif
# easyflash
CONFIG_LITTLEFS =y
CONFIG_LITTLEFS_KV_EASYFLASH =y
CONFIG_QCC74x_MTD =y
CONFIG_PARTITION =y

# usbh msc
ifeq ($(CONFIG_USBH_MSC),y)
    CONFIG_CHERRYUSB =y
    CONFIG_CHERRYUSB_OSAL =freertos
    CONFIG_CHERRYUSB_HOST =y
    CONFIG_CHERRYUSB_HOST_MSC =y
    CONFIG_FATFS =y
    CONFIG_FATFS_USBH =y
