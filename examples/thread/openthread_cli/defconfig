
CONFIG_NEWLIB =n
CONFIG_NEWLIB_STANDARD =n

CONFIG_VSNPRINTF_NANO =y
CONFIG_VSNPRINTF_FLOAT =y
CONFIG_VSNPRINTF_FLOAT_EX =y
CONFIG_VSNPRINTF_LONG_LONG =y

CONFIG_LITTLEFS =y
CONFIG_EASYFLASH4 =n
CONFIG_QCC74x_MTD =y
CONFIG_PARTITION =y

CONFIG_MBEDTLS =y
CONFIG_MBEDTLS_AES_USE_HW =n
CONFIG_MBEDTLS_BIGNUM_USE_HW =n
CONFIG_MBEDTLS_ECC_USE_HW =n
CONFIG_MBEDTLS_SHA1_USE_HW =n
CONFIG_MBEDTLS_SHA256_USE_HW =n
CONFIG_MBEDTLS_SHA512_USE_HW =n

CONFIG_QCC74xLOG =n

CONFIG_RF =y
CONFIG_LMAC154 =y
CONFIG_FREERTOS =y
CONFIG_THREAD =y
CONFIG_COREDUMP =y

ifeq ($(CONFIG_WIFI6),y)
	CONFIG_WIFI6 =y
	CONFIG_VIF_MAX =2
	CONFIG_STA_MAX =4
	ifeq ($(CONFIG_BLUETOOTH),y)
		CONFIG_MAC_TXQ_DEPTH =12
	else
		CONFIG_MAC_TXQ_DEPTH =32
	endif
	CONFIG_MAC_RXQ_DEPTH =12
	CONFIG_LWIP =y
	CONFIG_DHCPD =y
	CONFIG_PING =n
endif

ifeq ($(CONFIG_BLUETOOTH),y)
    CONFIG_BLUETOOTH =y
    CONFIG_BTBLECONTROLLER_LIB =ble1m2s1bredr0
	CONFIG_BT_SETTINGS =y
    CONFIG_DISABLE_BT_HOST_PRIVACY =y
    CONFIG_BLE_USE_MAC2 =n
	CONFIG_BT_STACK_CLI =y
    CONFIG_LITTLEFS_KV_EASYFLASH =$(CONFIG_LITTLEFS)
endif
